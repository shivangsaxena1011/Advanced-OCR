# Environment configuration
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Storage
STORAGE_PROVIDER=local
STORAGE_DIR=storage
MAX_FILE_SIZE_MB=50

# OCR Configuration
OCR_ENGINE=paddleocr
OCR_LANGUAGE=en
OCR_USE_GPU=false

# LLM / DocNova Configuration
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
